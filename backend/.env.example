# Copy this file to .env and fill in real values. Never commit the .env itself.

# Core Django configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origins of the React frontend (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IoT auto-request thresholds.
# A SYSTEM request is raised when a rule below is met.
CSRMS_NETWORK_FAILURE_COUNT=3
CSRMS_WATER_MOISTURE_THRESHOLD=60
CSRMS_FIRE_SMOKE_THRESHOLD=40
CSRMS_FIRE_TEMPERATURE_THRESHOLD=50
